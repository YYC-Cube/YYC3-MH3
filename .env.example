# ============================================================
# YYC³ MiniMax-H3 本地生产线 · 环境变量样例（Next.js 16 形态）
# 复制为 .env 后按需修改；.env 不入库（含密钥时永不入库）
# ============================================================
# 消费方: next.config.ts (basePath) / package.json scripts / 客户端 NEXT_PUBLIC_* 注入
# 契约: docs/06-Registry-API-契约.md §5
# ============================================================

# ---- 服务端口 ----
# Dev server 监听端口（package.json: next dev -p 3031）
# 默认 3031（团队规范「开发服务器端口 3030 起」递增分配；3030 由姊妹项目占用）
PORT=3031

# ---- 部署基路径 ----
# CI 注入（GH Pages 子路径基座 /YYC3-MH3）；自定义域（mh3.yyc3.top）留空 = 根基座
# 消费方: next.config.ts basePath；NEXT_PUBLIC_ 前缀供客户端（SW 注册路径）读取
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# ---- 前端可见变量（NEXT_PUBLIC_ 前缀才进入客户端 bundle）----
# Registry API（BFF Route Handler 于 P4 落地；当前 dev 优雅降级 memory 快照）
# 形态: http://127.0.0.1:${PORT}/api —— 见 docs/06-Registry-API-契约.md §5
NEXT_PUBLIC_REGISTRY_BASE_URL=http://127.0.0.1:3031/api

# 本地服务端口（前端回环兜底构造；仅当需要覆盖时取消注释）
# NEXT_PUBLIC_APP_PORT=3031

# 真实引擎通道（F-1 双 BFF 融合首步）：指向姊妹仓 YYC3-MiniMax-H3 的 console BFF（回环 only）
# 设置后 Workbench 任务队列直连后端 POST /pipeline/run + SSE /pipeline/stream；留空则用内存队列
# NEXT_PUBLIC_ENGINE_BASE_URL=http://127.0.0.1:3030/api
