# ============================================================
# YYC³ MiniMax-H3 本地生产线 · 环境变量样例
# 复制为 .env 后按需修改；.env 不入库（含密钥时永不入库）
# ============================================================
# 消费方: vite.config.ts (server.port / server.host / base)
# 前端可消费: 仅 VITE_ 前缀变量（Vite 约定）
# 契约: docs/06-Registry-API-契约.md §5
# ============================================================

# ---- 服务端口 ----
# Dev server / 预览服务监听端口（vite.config.ts: parseInt(process.env.PORT || "3031")）
# 默认 3031（团队规范「开发服务器端口 3030 起」递增分配；2026-10-12 由 8443 迁移，
# 3030 被姊妹项目 YYC3-MiniMax-3 dev server 占用，故取下一空闲位）
PORT=3031

# ---- 监听地址 ----
# 默认 0.0.0.0（Figma Make 宿主需要）；纯本地使用可收紧为 127.0.0.1
FIGMA_DEV_SERVER_HOST=0.0.0.0

# ---- 部署基路径 ----
# Figma 公共预览 URL；本地部署留空（base 回落 "/"）
FIGMA_PUBLIC_URL=

# ---- 前端可见变量（VITE_ 前缀才会进入客户端 bundle）----
# 说明：VITE_APP_PORT 由 vite.config.ts define 从 PORT 构建期注入，
#       无需在此声明；仅当需要覆盖时取消注释
# VITE_APP_PORT=3031

# ---- Registry API（PR-10 已实现：dev server 同源同端口桥接 /api，仅限回环地址）----
# 形态: http://127.0.0.1:${PORT}/api —— 见 docs/06-Registry-API-契约.md §5
# 缺省时适配器以 VITE_APP_PORT 构造；仅当需要覆盖时修改下方值
VITE_REGISTRY_BASE_URL=http://127.0.0.1:3031/api
