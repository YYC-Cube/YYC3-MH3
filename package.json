{
  "name": "yyc3-minimax-h3-diffsynth",
  "description": "YYC³ MiniMax-H3 DiffSynth 本地数字人生产线 · 五步闭环流水线 · 8 位 AI Family 多智能体协同 · 本地优先 100% 数据主权",
  "keywords": [
    "yanyucloudcube",
    "yyc3",
    "yyc3-mh3",
    "minimax-h3",
    "diffsynth",
    "ai-digital-human",
    "digital-human-production",
    "five-step-pipeline",
    "ai-family",
    "multi-agent",
    "seed-vault",
    "prompt-engineering",
    "local-first",
    "data-sovereignty",
    "pwa",
    "react-19",
    "next-16",
    "tailwindcss-4",
    "typescript-strict",
    "github-pages"
  ],
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-MH3.git"
  },
  "homepage": "https://mh3.yyc3.top",
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-MH3/issues"
  },
  "funding": {
    "type": "custom",
    "url": "https://github.com/YYC-Cube"
  },
  "scripts": {
    "dev": "next dev -p 3031",
    "build": "next build && node scripts/delay-hydration.mjs && node scripts/harden-csp.mjs",
    "start": "next start -p 3031",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:setup": "python3 -m venv .venv && .venv/bin/pip install -q -r scripts/e2e/requirements.txt && .venv/bin/python -m playwright install chromium",
    "test:e2e": "pnpm build && ./.venv/bin/python scripts/e2e/smoke.py",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src server",
    "check:knip": "knip --include dependencies,devDependencies,files,unlisted,unresolved,binaries",
    "check:lint": "eslint src server e2e",
    "check:csp": "node scripts/harden-csp.mjs --check",
    "check:build-time": "node scripts/check-build-time.mjs",
    "test:perf": "pnpm build && playwright test --config playwright.offline.config.ts e2e/perf.spec.ts",
    "test:offline": "pnpm build && playwright test --config playwright.offline.config.ts e2e/offline.spec.ts",
    "test:soak": ".venv/bin/python scripts/soak/memory-soak.py",
    "test:soak:short": ".venv/bin/python scripts/soak/memory-soak.py --duration-minutes 1 --interval-seconds 10",
    "profile:target": "tsx scripts/profile-target.ts",
    "profile:prof": "node scripts/profile-archive.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:obs": "tsx scripts/check-obs.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lighthouse": "^13.5.0",
    "madge": "^8.0.0",
    "oxfmt": "^0.73.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  }
}
